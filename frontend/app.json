{
  "expo": {
    "updates": {
      "enabled": false,
      "url": "https://u.expo.dev/d6e86a9a-ab9f-41af-8030-c5c5a2e9d751"
    },
    "name": "Anchor Voice",
    "slug": "anchor-voice",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "anchorvoice",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.anchor.voice",
      "buildNumber": "1",
      "config": {
        "usesNonExemptEncryption": false
      },
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Record voice messages for conflict management",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#000000"
      },
      "edgeToEdgeEnabled": true,
      "permissions": [
        "RECORD_AUDIO"
      ],
      "googleServicesFile": "./google-services.json",
      "package": "com.anchor.voice"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-image.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#000000"
        }
      ],
      "expo-font",
      "expo-web-browser",
      [
        "expo-share-intent",
        {
          "androidIntentFilters": [
            "audio/*"
          ],
          "androidMultiIntentFilters": [
            "audio/*"
          ],
          "iosActivationRules": {
            "NSExtensionActivationSupportsFileWithMaxCount": 1,
            "NSExtensionActivationSupportsMovieWithMaxCount": 0,
            "NSExtensionActivationSupportsImageWithMaxCount": 0,
            "NSExtensionActivationSupportsText": false,
            "NSExtensionActivationSupportsWebURLWithMaxCount": 0
          }
        }
      ],
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/icon.png",
          "color": "#9b59b6"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "apiUrl": "https://anchor-voice-production.up.railway.app",
      "router": {},
      "eas": {
        "projectId": "d6e86a9a-ab9f-41af-8030-c5c5a2e9d751"
      }
    },
    "owner": "deejayjustin",
    "runtimeVersion": {
      "policy": "appVersion"
    }
  }
}
