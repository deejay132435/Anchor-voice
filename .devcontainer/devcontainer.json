{
  "forwardPorts": [8001],
  "portsAttributes": {
    "8001": {
      "label": "Anchor Backend",
      "visibility": "public",
      "onAutoForward": "notify"
    }
  },
  "postStartCommand": "cd /workspaces/Anchor-voice/backend && nohup uvicorn server:app --host 0.0.0.0 --port 8001 --reload > /tmp/backend.log 2>&1 &"
}
